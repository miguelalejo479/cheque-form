<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Cheque Request Form Generator</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/react/18.2.0/umd/react.production.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/react-dom/18.2.0/umd/react-dom.production.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/babel-standalone/7.23.2/babel.min.js"></script>
<style>
  * { box-sizing: border-box; }
  body { margin: 0; font-family: Calibri, Arial, sans-serif; font-size: 13px; background: #f9f9f9; }
  @media print { body { background: #fff; } .no-print { display: none !important; } }
</style>
</head>
<body>
<div id="root"></div>
<script type="text/babel">
const { useState, useCallback, useRef } = React;

const PAYMENT_SETTINGS = {
  paymentType: 6, payeeType: 1, currency: 2,
  paymentMethod: 1, itemNumber: "N/A", otherInstructions: 2,
  approverName: "Craig Segaric",
};

const ADJUSTER_FIRMS = {
  ClaimsPro: {
    offices: {
      Edmonton:   { defaultPayee: "ClaimsPro", careOf: "", address2: "200 – 8560 Roper Rd NW", city: "Edmonton", province: "AB", postalCode: "T6E 6V4", adjusterFee: true },
      Burnaby:    { defaultPayee: "", careOf: "c/o ClaimsPro", address2: "#202 – 8333 Eastlake Drive", city: "Burnaby", province: "BC", postalCode: "V5A 4W2", adjusterFee: false },
      Surrey:     { defaultPayee: "", careOf: "c/o ClaimsPro", address2: "#2009 – 7495 – 132 Street", city: "Surrey", province: "BC", postalCode: "V3W 1J8", adjusterFee: false },
      Vancouver:  { defaultPayee: "", careOf: "c/o ClaimsPro", address2: "#600 – 1111 Melville Street", city: "Vancouver", province: "BC", postalCode: "V6E 3V6", adjusterFee: false },
      Kamloops:   { defaultPayee: "", careOf: "c/o ClaimsPro", address2: "#204 – 635 Victoria Street", city: "Kamloops", province: "BC", postalCode: "V2C 2B3", adjusterFee: false },
      Abbotsford: { defaultPayee: "", careOf: "c/o ClaimsPro", address2: "#203 – 2890 Garden Street", city: "Abbotsford", province: "BC", postalCode: "V2T 4W7", adjusterFee: false },
      Kelowna:    { defaultPayee: "", careOf: "c/o ClaimsPro", address2: "205 – 1726 Dolphin Avenue", city: "Kelowna", province: "BC", postalCode: "V1Y 9R9", adjusterFee: false },
    }
  },
  Sedgwick: {
    offices: {
      Toronto: { defaultPayee: "Sedgwick Canada Inc.", careOf: "c/o T44160C", address2: "P.O. Box 4416, Station A", city: "Toronto", province: "ON", postalCode: "M5W 4L1", adjusterFee: true },
      Langley: { defaultPayee: "", careOf: "c/o Sedgwick Canada Inc.", address2: "#304 – 9440 202nd Street", city: "Langley", province: "BC", postalCode: "V1M 4A6", adjusterFee: false },
    }
  },
  Custom: { offices: {} }
};

const CARRIERS = [
  { label: "Trisura",       code: "CLAIMS-RTR", contractPrefix: null,          fixedShare: null, suffix: "RTR" },
  { label: "Red River",     code: "CLAIMS-RRR", contractPrefix: null,          fixedShare: 5,    suffix: "RRR" },
  { label: "Ambris C50218", code: "CLAIMS-RA1", contractPrefix: "B1306C50218", fixedShare: null, suffix: "RA1" },
  { label: "Ambris C00241", code: "CLAIMS-RA2", contractPrefix: "C1306C00241", fixedShare: null, suffix: "RA2" },
  { label: "AxaXL",         code: "CLAIMS-RM5", contractPrefix: "B1000P06123", fixedShare: null, suffix: "RM5" },
];

const parseDOL = (raw) => {
  if (!raw) return { label: "", mmddyy: "" };
  const months = ["jan","feb","mar","apr","may","jun","jul","aug","sep","oct","nov","dec"];
  const mLabel = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
  const written = raw.trim().match(/^([a-zA-Z]{3})\s+(\d{1,2})\/(\d{2})$/);
  if (written) {
    const mi = months.indexOf(written[1].toLowerCase());
    if (mi === -1) return { label: "", mmddyy: "" };
    const mm = String(mi+1).padStart(2,"0"), dd = written[2].padStart(2,"0"), yy = written[3];
    return { label: `${mLabel[mi]} ${parseInt(dd,10)}/${yy}`, mmddyy: `${mm}${dd}${yy}` };
  }
  if (/^\d{6}$/.test(raw.trim())) {
    const mm = raw.slice(0,2), dd = raw.slice(2,4), yy = raw.slice(4,6);
    const mi = parseInt(mm,10)-1;
    if (mi < 0 || mi > 11) return { label: "", mmddyy: "" };
    return { label: `${mLabel[mi]} ${parseInt(dd,10)}/${yy}`, mmddyy: raw.trim() };
  }
  return { label: "", mmddyy: "" };
};

const fmtAmount = (val) => {
  const n = parseFloat((val||"").replace(/[^0-9.]/g,""));
  return isNaN(n) ? (val||"") : `$${n.toLocaleString("en-CA",{minimumFractionDigits:2,maximumFractionDigits:2})}`;
};
const parseAmt = (val) => { const n = parseFloat((val||"").replace(/[^0-9.]/g,"")); return isNaN(n) ? null : n; };
const getCarrierMeta = (label) => CARRIERS.find(c => c.label === label) || null;

const buildDesc = (claimNum, strataPlan, dolLabel, carrier, share, kind) => {
  const shareStr = share ? ` ${share}%` : "";
  const cLabel = carrier ? `(${carrier}${shareStr})` : "";
  return `${claimNum||""} - ${strataPlan||""} ${cLabel} - ${dolLabel} - ${kind}`;
};
const getContract = (label, suffix) => {
  const meta = getCarrierMeta(label);
  if (!meta) return "";
  if (!meta.contractPrefix) return "N/A";
  return `${meta.contractPrefix}${suffix || "XXXX"}`;
};
const emptyCD = (label) => {
  const meta = getCarrierMeta(label);
  return { contractSuffix:"", chequeAmount:"", claimNumber:"", carrierShare: meta?.fixedShare != null ? String(meta.fixedShare) : "", adjustorInvoice:"" };
};
const maybeSortedByShare = (labels, dataMap) => {
  const allFilled = labels.every(l => { const sh = parseFloat((dataMap[l]?.carrierShare||"").replace(/[^0-9.]/g,"")); return !isNaN(sh) && sh > 0; });
  if (!allFilled) return [...labels];
  return [...labels].sort((a,b) => { const sa = parseFloat((dataMap[a]?.carrierShare||"0").replace(/[^0-9.]/g,""))||0, sb = parseFloat((dataMap[b]?.carrierShare||"0").replace(/[^0-9.]/g,""))||0; return sb-sa; });
};

const C = { TH_BLUE_BG:"#cfe2f3", TD_BLUE_BG:"#daeef3", TH_GREEN_BG:"#d9ead3", TD_GREEN_BG:"#f4f9f2", BORDER:"#000" };

function buildHtmlTable(rows) {
  const cellHtml = (c) => {
    const cs = c.colspan > 1 ? ` colspan="${c.colspan}"` : "";
    const style = [`background:${c.bg||"#ffffff"}`,`border:1px solid ${C.BORDER}`,`padding:3px 6px`,`font-family:Calibri,Arial,sans-serif`,`font-size:11pt`,c.bold?"font-weight:bold":"",c.center?"text-align:center":"",c.nowrap?"white-space:nowrap":""].filter(Boolean).join(";");
    return `<td${cs} style="${style}">${c.text||""}</td>`;
  };
  return `<table style="border-collapse:collapse;font-family:Calibri,Arial,sans-serif;font-size:11pt;"><tbody>${rows.map(r=>`<tr>${r.cells.map(cellHtml).join("")}</tr>`).join("")}</tbody></table>`;
}

const INIT = {
  firm:null, office:null,
  customAddr:{payeeName:"",careOf:"",address2:"",address3:"",city:"",province:"",postalCode:""},
  payeeName:"", strataPlan:"", dolRaw:"", paymentKind:"INDEMNITY",
  universalInvoice:"", selectedCarriers:[], carrierData:{},
  sameClaimNum:false, baseClaimNum:"", feeType:"", displayOrder:[],
};

// ── Invoice Reader ──────────────────────────────────────────────────────────
function InvoiceReader({ onExtracted, apiKey }) {
  const [mode, setMode] = useState(null);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState("");
  const [dragOver, setDragOver] = useState(false);
  const [preview, setPreview] = useState(null);
  const fileRef = useRef();

  const toBase64 = (file) => new Promise((res,rej) => {
    const r = new FileReader();
    r.onload = () => res(r.result.split(",")[1]);
    r.onerror = () => rej(new Error("Read failed"));
    r.readAsDataURL(file);
  });

  const systemPrompt = (m) => m === "full"
    ? `You are extracting data from a strata insurance cheque request or invoice PDF. Return ONLY valid JSON (no markdown, no backticks) with these fields:
{"payeeName":"","strataPlan":"","dol":"(MMDDYY if found else empty)","paymentKind":"INDEMNITY or EXPENSE","universalInvoice":"","carriers":[{"label":"one of: Trisura|Red River|Ambris C50218|Ambris C00241|AxaXL","carrierShare":"number only","chequeAmount":"number only","claimNumber":"","contractSuffix":"last 4 digits if present","adjustorInvoice":""}]}
Only include carriers you can identify. Leave fields as empty string if not found.`
    : `You are extracting partial data from a strata insurance cheque request or invoice PDF. Return ONLY valid JSON (no markdown, no backticks) with:
{"payeeName":"","carriers":[{"label":"one of: Trisura|Red River|Ambris C50218|Ambris C00241|AxaXL","carrierShare":"number only","chequeAmount":"number only"}]}
Only include carriers you can identify. Leave fields as empty string if not found.`;

  const processFile = async (file) => {
    if (!file || file.type !== "application/pdf") { setError("Please upload a PDF file."); return; }
    if (!mode) { setError("Please select an extraction mode first."); return; }
    if (!apiKey || !apiKey.trim()) { setError("Please enter your Anthropic API key above."); return; }
    setError(""); setLoading(true); setPreview(null);
    try {
      const b64 = await toBase64(file);
      const resp = await fetch("https://api.anthropic.com/v1/messages", {
        method:"POST",
        headers:{"Content-Type":"application/json","x-api-key":apiKey.trim(),"anthropic-version":"2023-06-01","anthropic-dangerous-direct-browser-access":"true"},
        body:JSON.stringify({
          model:"claude-sonnet-4-20250514", max_tokens:1000,
          system: systemPrompt(mode),
          messages:[{ role:"user", content:[
            { type:"document", source:{ type:"base64", media_type:"application/pdf", data:b64 } },
            { type:"text", text:"Extract the required fields from this invoice." }
          ]}]
        })
      });
      const data = await resp.json();
      if (data.error) throw new Error(data.error.message);
      const raw = (data.content||[]).filter(b=>b.type==="text").map(b=>b.text).join("");
      const parsed = JSON.parse(raw.replace(/```json|```/g,"").trim());
      setPreview({ data:parsed, mode });
    } catch(e) {
      setError("Extraction failed: " + e.message);
    }
    setLoading(false);
  };

  const applyExtracted = () => { if (preview) { onExtracted(preview.data, preview.mode); setPreview(null); } };

  return (
    <div style={{marginBottom:16,padding:12,border:"2px solid #93c5fd",borderRadius:4,background:"#f0f7ff"}}>
      <div style={{fontWeight:"bold",marginBottom:10,color:"#1d4ed8"}}>📄 Invoice Reader</div>
      <div style={{marginBottom:10}}>
        <div style={{marginBottom:6,fontWeight:"bold"}}>Extraction Mode</div>
        <div style={{display:"flex",gap:8,flexWrap:"wrap"}}>
          <button onClick={()=>setMode("full")} style={mode==="full"?btnSel:btnUnsel}>Full Extract — all fields incl. claim numbers</button>
          <button onClick={()=>setMode("partial")} style={mode==="partial"?btnSel:btnUnsel}>Partial Extract — payee, carriers, shares &amp; amounts only</button>
        </div>
      </div>
      <div
        onDragOver={e=>{e.preventDefault();setDragOver(true);}}
        onDragLeave={()=>setDragOver(false)}
        onDrop={e=>{e.preventDefault();setDragOver(false);const f=e.dataTransfer.files[0];if(f)processFile(f);}}
        onClick={()=>fileRef.current&&fileRef.current.click()}
        style={{border:`2px dashed ${dragOver?"#2563eb":"#93c5fd"}`,borderRadius:6,padding:24,textAlign:"center",cursor:"pointer",background:dragOver?"#dbeafe":"#eff6ff",transition:"background 0.2s"}}
      >
        <input ref={fileRef} type="file" accept="application/pdf" style={{display:"none"}}
          onChange={e=>e.target.files[0]&&processFile(e.target.files[0])} />
        {loading
          ? <span style={{color:"#2563eb"}}>⏳ Reading invoice…</span>
          : <span>Drop PDF here or <strong>click to browse</strong></span>
        }
      </div>
      {error && <div style={{color:"#dc2626",marginTop:8,fontSize:12}}>{error}</div>}
      {preview && (
        <div style={{marginTop:12,background:"#fff",border:"1px solid #bcd",borderRadius:4,padding:"10px 12px",fontSize:12}}>
          <div style={{fontWeight:"bold",marginBottom:6,color:"#1d4ed8"}}>Extracted — review before applying:</div>
          <pre style={{margin:0,fontSize:11,whiteSpace:"pre-wrap",color:"#333",maxHeight:200,overflow:"auto"}}>{JSON.stringify(preview.data,null,2)}</pre>
          <div style={{display:"flex",gap:8,marginTop:10}}>
            <button onClick={applyExtracted} style={{...btnPrimary,background:"#15803d",fontSize:12,padding:"6px 14px"}}>✓ Apply to Form</button>
            <button onClick={()=>setPreview(null)} style={{...btnUnsel,fontSize:12,padding:"6px 14px"}}>✕ Discard</button>
          </div>
        </div>
      )}
    </div>
  );
}

function App() {
  const [s, setS] = useState(INIT);
  const [showPreview, setShowPreview] = useState(false);
  const [copied, setCopied] = useState(false);
  const [emailCopied, setEmailCopied] = useState(false);
  const [showRefreshConfirm, setShowRefreshConfirm] = useState(false);
  const [apiKey, setApiKey] = useState("");
  const [showApiKey, setShowApiKey] = useState(false);

  const upd = (k,v) => setS(p=>({...p,[k]:v}));
  const { firm, office, customAddr, payeeName, strataPlan, dolRaw, paymentKind,
          universalInvoice, selectedCarriers, carrierData, sameClaimNum, baseClaimNum, feeType, displayOrder } = s;

  const officeInfo = firm && firm!=="Custom" && office ? ADJUSTER_FIRMS[firm].offices[office] : null;
  const isAdjusterFee = officeInfo?.adjusterFee||false;
  const effectiveKind = isAdjusterFee ? "EXPENSE" : paymentKind;

  const selectOffice = (f,o) => { const info=ADJUSTER_FIRMS[f].offices[o]; setS(p=>({...p,firm:f,office:o,payeeName:info.adjusterFee?info.defaultPayee:""})); };

  const toggleCarrier = (label) => {
    setS(p => {
      const sel=p.selectedCarriers;
      if (sel.includes(label)) return {...p,selectedCarriers:sel.filter(l=>l!==label),displayOrder:p.displayOrder.filter(l=>l!==label)};
      if (sel.length>=5) return p;
      const cd=p.carrierData[label]?p.carrierData:{...p.carrierData,[label]:emptyCD(label)};
      return {...p,selectedCarriers:[...sel,label],carrierData:cd,displayOrder:[...p.displayOrder,label]};
    });
  };

  const updateCD = (label,k,v) => setS(p=>({...p,carrierData:{...p.carrierData,[label]:{...p.carrierData[label],[k]:v}}}));

  const recalc = useCallback((srcLabel,newAmt,allData,selCarriers) => {
    const base=parseAmt(newAmt); if(base===null) return allData;
    const srcShare=parseFloat((allData[srcLabel]?.carrierShare||"").replace(/[^0-9.]/g,""));
    if(!srcShare) return allData;
    const unit=base/srcShare, updated={...allData};
    selCarriers.forEach(lbl => {
      if(lbl===srcLabel) return;
      const sh=parseFloat((allData[lbl]?.carrierShare||"").replace(/[^0-9.]/g,""));
      if(!isNaN(sh)&&sh>0) updated[lbl]={...updated[lbl],chequeAmount:(unit*sh).toFixed(2)};
    });
    return updated;
  },[]);

  const handleAmountChange = (label,val) => setS(p => { const u={...p.carrierData,[label]:{...p.carrierData[label],chequeAmount:val}}; return {...p,carrierData:recalc(label,val,u,p.selectedCarriers)}; });
  const handleShareChange = (label,val) => setS(p => { const u={...p.carrierData,[label]:{...p.carrierData[label],carrierShare:val}}; const src=p.selectedCarriers.find(l=>l!==label&&parseAmt(u[l]?.chequeAmount)!==null&&parseFloat(u[l]?.carrierShare)>0); return {...p,carrierData:src?recalc(src,u[src].chequeAmount,u,p.selectedCarriers):u}; });

  const handleCarrierRefresh = () => setS(p => {
    const sorted=maybeSortedByShare(p.selectedCarriers,p.carrierData);
    const src=sorted.find(l=>parseAmt(p.carrierData[l]?.chequeAmount)!==null&&parseFloat(p.carrierData[l]?.carrierShare)>0);
    const newCD=src?recalc(src,p.carrierData[src].chequeAmount,p.carrierData,p.selectedCarriers):p.carrierData;
    return {...p,carrierData:newCD,displayOrder:sorted};
  });

  const handleExtracted = (data, mode) => {
    setS(p => {
      let next={...p};
      if (mode==="full") {
        if(data.payeeName) next.payeeName=data.payeeName;
        if(data.strataPlan) next.strataPlan=data.strataPlan;
        if(data.dol) next.dolRaw=data.dol;
        if(data.paymentKind) next.paymentKind=data.paymentKind;
        if(data.universalInvoice) next.universalInvoice=data.universalInvoice;
      } else {
        if(data.payeeName) next.payeeName=data.payeeName;
      }
      if(data.carriers?.length>0) {
        const newSel=[...p.selectedCarriers], newCD={...p.carrierData}, newOrder=[...p.displayOrder];
        data.carriers.forEach(c => {
          const meta=getCarrierMeta(c.label); if(!meta) return;
          if(!newSel.includes(c.label)&&newSel.length<5){newSel.push(c.label);newOrder.push(c.label);}
          const ex=newCD[c.label]||emptyCD(c.label);
          newCD[c.label]={...ex,
            ...(c.carrierShare&&meta.fixedShare==null?{carrierShare:c.carrierShare}:{}),
            ...(c.chequeAmount?{chequeAmount:c.chequeAmount}:{}),
            ...(mode==="full"&&c.claimNumber?{claimNumber:c.claimNumber}:{}),
            ...(mode==="full"&&c.contractSuffix?{contractSuffix:c.contractSuffix}:{}),
            ...(mode==="full"&&c.adjustorInvoice?{adjustorInvoice:c.adjustorInvoice}:{}),
          };
        });
        next.selectedCarriers=newSel; next.carrierData=newCD; next.displayOrder=newOrder;
      }
      return next;
    });
  };

  const addr = firm==="Custom" ? customAddr : (officeInfo||{});
  const dol = parseDOL(dolRaw);
  const getClaimNum = (label) => { if(!sameClaimNum) return carrierData[label]?.claimNumber||""; return baseClaimNum?`${baseClaimNum}-${getCarrierMeta(label)?.suffix||""}`:""; };
  const orderedCarriers = displayOrder.filter(l=>selectedCarriers.includes(l));
  const previewCarriers = maybeSortedByShare(selectedCarriers,carrierData);
  const displayPayeeName = isAdjusterFee ? payeeName : (payeeName||(firm==="Custom"?customAddr.payeeName:""));
  const feeAppend = isAdjusterFee&&feeType?` - ${feeType}`:"";
  const emailSubject = `CHEQUE REQUEST - ${strataPlan||"STRATA"} - ${dol.label||"DOL"} - ${effectiveKind} (${displayPayeeName||"Payee"})${feeAppend}`;

  const copyText = (text,setter) => navigator.clipboard.writeText(text).then(()=>{setter(true);setTimeout(()=>setter(false),2000);});

  const copyTableRich = () => {
    const rows=[];
    rows.push({cells:[{text:"Contact",bg:C.TH_BLUE_BG,bold:true,center:true,colspan:2},{text:""},{text:"Applicable to each request",bg:C.TH_BLUE_BG,bold:true,center:true,colspan:2}]});
    [["Name",displayPayeeName,"Payment Type:",PAYMENT_SETTINGS.paymentType],["",addr.careOf||"","Payee Type",PAYMENT_SETTINGS.payeeType],["Address 2",addr.address2||"","Currency",PAYMENT_SETTINGS.currency],["Address 3",addr.address3||"","Payment method",PAYMENT_SETTINGS.paymentMethod],["City",addr.city||"","Item Number",PAYMENT_SETTINGS.itemNumber],["Province",addr.province||"","Other instructions",PAYMENT_SETTINGS.otherInstructions],["Postal Code",addr.postalCode||"","Approver Name & Title",PAYMENT_SETTINGS.approverName]]
    .forEach(([l,v,rl,rv])=>rows.push({cells:[{text:l,bg:C.TH_BLUE_BG,bold:true},{text:v,bg:C.TD_BLUE_BG},{text:""},{text:rl,bg:C.TH_BLUE_BG,bold:true},{text:String(rv),bg:C.TD_BLUE_BG}]}));
    rows.push({cells:[{text:"",colspan:5}]});
    rows.push({cells:[{text:"Individual Carrier Details",bg:C.TH_GREEN_BG,bold:true,center:true,colspan:5}]});
    previewCarriers.forEach((label,idx) => {
      const meta=getCarrierMeta(label),cd=carrierData[label]||emptyCD(label),claimNum=getClaimNum(label);
      const desc=buildDesc(claimNum,strataPlan,dol.label,label,cd.carrierShare,effectiveKind);
      const contract=getContract(label,cd.contractSuffix),invoiceNum=isAdjusterFee?cd.adjustorInvoice:universalInvoice;
      if(idx>0) rows.push({cells:[{text:"",colspan:5}]});
      const gr=(lbl,val)=>({cells:[{text:lbl,bg:C.TH_GREEN_BG,bold:true,nowrap:true},{text:val,bg:C.TD_GREEN_BG,colspan:4}]});
      rows.push(gr("Look up Code",meta?.code||""));rows.push(gr("Cheque Amount",fmtAmount(cd.chequeAmount)));rows.push(gr("Carrier Contract #",contract));rows.push(gr("Attachment / Activity Description",desc));rows.push(gr("Cheque Memo",desc));rows.push(gr("Claim Number",claimNum));
      if(invoiceNum) rows.push(gr("Adjustor Invoice Number",invoiceNum));
    });
    const html=buildHtmlTable(rows), plain=rows.map(r=>r.cells.map(c=>c.text||"").join("\t")).join("\n");
    try {
      navigator.clipboard.write([new ClipboardItem({"text/html":new Blob([html],{type:"text/html"}),"text/plain":new Blob([plain],{type:"text/plain"})})]).then(()=>{setCopied(true);setTimeout(()=>setCopied(false),2000);});
    } catch(e) { navigator.clipboard.writeText(plain).then(()=>{setCopied(true);setTimeout(()=>setCopied(false),2000);}); }
  };

  const doRefresh = () => { setS(INIT); setShowPreview(false); setShowRefreshConfirm(false); };

  const TH_BLUE={background:C.TH_BLUE_BG,fontWeight:"bold",border:`1px solid ${C.BORDER}`,padding:"3px 6px",fontSize:12,textAlign:"center"};
  const TD_BLUE={background:C.TD_BLUE_BG,border:`1px solid ${C.BORDER}`,padding:"3px 6px",fontSize:12};
  const TH_BLUE_L={background:C.TH_BLUE_BG,fontWeight:"bold",border:`1px solid ${C.BORDER}`,padding:"3px 6px",fontSize:12};
  const TH_GREEN={background:C.TH_GREEN_BG,fontWeight:"bold",border:`1px solid ${C.BORDER}`,padding:"3px 6px",fontSize:12,whiteSpace:"nowrap"};
  const TD_GREEN={background:C.TD_GREEN_BG,border:`1px solid ${C.BORDER}`,padding:"3px 6px",fontSize:12};
  const TD_PLAIN={border:`1px solid ${C.BORDER}`,padding:"3px 6px",fontSize:12};
  const TH_GREEN_C={...TH_GREEN,textAlign:"center",whiteSpace:"normal"};

  return (
    <div style={{fontFamily:"Calibri, Arial, sans-serif",fontSize:13,padding:20,maxWidth:960,margin:"0 auto"}}>
      <div style={{display:"flex",justifyContent:"space-between",alignItems:"center",marginBottom:16}}>
        <h2 style={{fontSize:16,margin:0}}>Cheque Request Form Generator</h2>
        <div style={{position:"relative"}}>
          <button onClick={()=>setShowRefreshConfirm(true)} style={btnDanger}>↺ Reset Form</button>
          {showRefreshConfirm&&(
            <div style={{position:"absolute",right:0,top:"110%",background:"#fff",border:"1px solid #dc2626",borderRadius:6,padding:"10px 14px",zIndex:100,width:220,boxShadow:"0 2px 8px rgba(0,0,0,0.15)"}}>
              <div style={{marginBottom:8,fontSize:13}}>Clear all form data?</div>
              <div style={{display:"flex",gap:8}}>
                <button onClick={doRefresh} style={{...btnPrimary,background:"#dc2626",padding:"5px 12px"}}>Yes, reset</button>
                <button onClick={()=>setShowRefreshConfirm(false)} style={{...btnUnsel,padding:"5px 12px"}}>Cancel</button>
              </div>
            </div>
          )}
        </div>
      </div>

      {!showPreview ? (<>

        {/* API Key input */}
        <div style={{marginBottom:16,padding:"10px 14px",background:"#fefce8",border:"1px solid #fbbf24",borderRadius:4,fontSize:12}}>
          <div style={{fontWeight:"bold",marginBottom:6,color:"#92400e"}}>🔑 Anthropic API Key — required for Invoice Reader only</div>
          <div style={{display:"flex",gap:8,alignItems:"center"}}>
            <input
              type={showApiKey?"text":"password"}
              style={{...inp,marginTop:0,maxWidth:420,fontFamily:"monospace"}}
              value={apiKey}
              onChange={e=>setApiKey(e.target.value)}
              placeholder="sk-ant-..."
            />
            <button onClick={()=>setShowApiKey(v=>!v)} style={{...btnUnsel,padding:"4px 10px",fontSize:12}}>{showApiKey?"Hide":"Show"}</button>
          </div>
          <div style={{marginTop:5,color:"#78350f"}}>Your key is only used in this browser session and never stored or sent anywhere except to Anthropic's API.</div>
        </div>

        {/* Invoice Reader */}
        <InvoiceReader onExtracted={handleExtracted} apiKey={apiKey} />

        <fieldset style={fs}>
          <legend style={leg}>1. Adjuster Firm & Office</legend>
          <div style={{display:"flex",gap:8,flexWrap:"wrap",marginBottom:10}}>
            {["ClaimsPro","Sedgwick","Custom"].map(f=>(
              <button key={f} onClick={()=>setS(p=>({...p,firm:f,office:null,payeeName:""}))} style={firm===f?btnSel:btnUnsel}>{f}</button>
            ))}
          </div>
          {firm&&firm!=="Custom"&&(
            <div style={{marginBottom:10}}>
              <div style={{marginBottom:4,fontWeight:"bold"}}>Office</div>
              <div style={{display:"flex",gap:8,flexWrap:"wrap"}}>
                {Object.keys(ADJUSTER_FIRMS[firm].offices).map(o=>(
                  <button key={o} onClick={()=>selectOffice(firm,o)} style={office===o?btnSel:btnUnsel}>{o}</button>
                ))}
              </div>
            </div>
          )}
          {firm==="Custom"&&(
            <div style={{...grid2,marginTop:8}}>
              {[["Payee Name","payeeName"],["Care Of","careOf"],["Address 2","address2"],["Address 3","address3"],["City","city"],["Province","province"],["Postal Code","postalCode"]].map(([lbl,k])=>(
                <label key={k}>{lbl}<input style={inp} value={customAddr[k]} onChange={e=>setS(p=>({...p,customAddr:{...p.customAddr,[k]:e.target.value}}))} /></label>
              ))}
            </div>
          )}
          {officeInfo&&(<>
            <div style={{background:"#f0f7ff",border:"1px solid #bcd",borderRadius:4,padding:"8px 12px",fontSize:12,color:"#336",marginBottom:8}}>
              {addr.careOf&&<><strong>{addr.careOf}</strong><br/></>}
              {addr.address2}<br/>{addr.city}, {addr.province} {addr.postalCode}
              {isAdjusterFee&&<div style={{color:"#a00",marginTop:4}}>⚠ Adjuster Fee office — Payment type locked to EXPENSE. Invoice # is per carrier.</div>}
            </div>
            {!isAdjusterFee&&(<label style={{display:"block",marginTop:6}}>Payee Name<input style={inp} value={payeeName} onChange={e=>upd("payeeName",e.target.value)} placeholder="e.g. Owners of Strata Plan LMS 381" /></label>)}
          </>)}
        </fieldset>

        <fieldset style={fs}>
          <legend style={leg}>2. Strata & Payment Info</legend>
          <div style={grid2}>
            <label>Strata Plan<input style={inp} value={strataPlan} onChange={e=>upd("strataPlan",e.target.value.toUpperCase().replace(/[^A-Z0-9 ]/g,""))} placeholder="LMS 381" /></label>
            <label>Date of Loss (MMDDYY or Mon DD/YY)
              <input style={inp} value={dolRaw} onChange={e=>upd("dolRaw",e.target.value)} placeholder="011324 or Jan 13/24" />
              {dolRaw&&<span style={{fontSize:11,color:dol.label?"#060":"#c00",marginTop:2,display:"block"}}>{dol.label||"Invalid date"}</span>}
            </label>
          </div>
          <div style={{marginTop:10}}>
            <div style={{marginBottom:4,fontWeight:"bold"}}>Payment Type</div>
            <div style={{display:"flex",gap:8}}>
              {["INDEMNITY","EXPENSE"].map(k=>(
                <button key={k} onClick={()=>!isAdjusterFee&&upd("paymentKind",k)}
                  style={{...(effectiveKind===k?btnSel:btnUnsel),opacity:isAdjusterFee&&k==="INDEMNITY"?0.4:1,cursor:isAdjusterFee&&k==="INDEMNITY"?"not-allowed":"pointer"}}>{k}</button>
              ))}
            </div>
          </div>
          {!isAdjusterFee&&(<label style={{display:"block",marginTop:10}}>Adjustor Invoice # (universal)<input style={inp} value={universalInvoice} onChange={e=>upd("universalInvoice",e.target.value)} placeholder="53310-1020078" /></label>)}
        </fieldset>

        <fieldset style={fs}>
          <legend style={leg}>3. Select Carriers (max 5)</legend>
          <div style={{display:"flex",gap:8,flexWrap:"wrap",marginBottom:12}}>
            {CARRIERS.map(({label})=>(
              <button key={label} onClick={()=>toggleCarrier(label)} style={selectedCarriers.includes(label)?btnSel:btnUnsel}>{label}</button>
            ))}
          </div>
          {selectedCarriers.length>0&&(<>
            <div style={{marginBottom:12,padding:"8px 12px",background:"#fffbeb",border:"1px solid #d97706",borderRadius:4}}>
              <label style={{display:"flex",alignItems:"center",gap:8,cursor:"pointer",fontWeight:"bold"}}>
                <input type="checkbox" checked={sameClaimNum} onChange={e=>upd("sameClaimNum",e.target.checked)} />
                Same claim number for all carriers (appends -RTR / -RRR / etc.)
              </label>
              {sameClaimNum&&(
                <div style={{marginTop:8}}>
                  <label>Base Claim Number<input style={inp} value={baseClaimNum} onChange={e=>upd("baseClaimNum",e.target.value)} placeholder="511794" /></label>
                  {baseClaimNum&&<div style={{marginTop:6,fontSize:12,color:"#555"}}>{selectedCarriers.map(l=><div key={l}>{l}: <strong>{baseClaimNum}-{getCarrierMeta(l)?.suffix}</strong></div>)}</div>}
                </div>
              )}
            </div>
            <div style={{display:"flex",justifyContent:"flex-end",marginBottom:8}}>
              <button onClick={handleCarrierRefresh} style={{...btnPrimary,background:"#0f766e",fontSize:12,padding:"5px 12px"}}>↺ Recalculate &amp; Re-sort Carriers</button>
            </div>
          </>)}
          {orderedCarriers.map(label=>{
            const meta=getCarrierMeta(label),cd=carrierData[label]||emptyCD(label),claimNum=getClaimNum(label);
            const desc=buildDesc(claimNum,strataPlan,dol.label,label,cd.carrierShare,effectiveKind);
            return (
              <div key={label} style={{border:"1px solid #ddd",borderRadius:4,padding:10,marginBottom:10,background:"#fafafa"}}>
                <div style={{fontWeight:"bold",marginBottom:8,color:"#1a3a6b"}}>{label} <span style={{fontWeight:"normal",color:"#888",fontSize:12}}>({meta?.code})</span></div>
                <div style={grid2}>
                  <label>Carrier Contract #
                    {!meta?.contractPrefix?<input style={{...inp,background:"#eee"}} value="N/A" readOnly/>
                      :<div style={{display:"flex",gap:4,alignItems:"center",marginTop:3}}>
                        <input style={{...inp,marginTop:0,background:"#eee",flex:"0 0 auto",width:"auto"}} value={meta.contractPrefix} readOnly/>
                        <input style={{...inp,marginTop:0,width:60}} maxLength={4} value={cd.contractSuffix} onChange={e=>updateCD(label,"contractSuffix",e.target.value)} placeholder="XXXX"/>
                      </div>}
                  </label>
                  <label>Claim Number<input style={sameClaimNum?{...inp,background:"#eee"}:inp} inputMode="numeric" value={sameClaimNum?claimNum:cd.claimNumber} readOnly={sameClaimNum} onChange={e=>!sameClaimNum&&updateCD(label,"claimNumber",e.target.value.replace(/[^0-9]/g,""))} placeholder="511794"/></label>
                  <label>Carrier Share %
                    {meta?.fixedShare!=null?<input style={{...inp,background:"#eee"}} value={cd.carrierShare} readOnly/>
                      :<input style={inp} inputMode="decimal" value={cd.carrierShare} onChange={e=>handleShareChange(label,e.target.value.replace(/[^0-9.]/g,""))} placeholder="20"/>}
                  </label>
                  <label>Cheque Amount<input style={inp} inputMode="decimal" value={cd.chequeAmount} onChange={e=>handleAmountChange(label,e.target.value.replace(/[^0-9.]/g,""))} placeholder="2038.32"/></label>
                  {isAdjusterFee&&(<label>Adjustor Invoice # (carrier-specific)<input style={inp} value={cd.adjustorInvoice} onChange={e=>updateCD(label,"adjustorInvoice",e.target.value)} placeholder="53310-1020078"/></label>)}
                  <label style={{gridColumn:"1 / -1"}}>Description Preview<input style={{...inp,background:"#eee",color:"#555"}} value={desc} readOnly/></label>
                </div>
              </div>
            );
          })}
        </fieldset>

        <div style={{display:"flex",justifyContent:"space-between",alignItems:"center",marginBottom:12}}>
          <button onClick={()=>setS(p=>{
            const freshCD={};
            p.selectedCarriers.forEach(l=>{const old=p.carrierData[l]||emptyCD(l);freshCD[l]={...emptyCD(l),carrierShare:old.carrierShare,claimNumber:old.claimNumber};});
            return {...p,dolRaw:"",paymentKind:"INDEMNITY",universalInvoice:"",strataPlan:"",carrierData:freshCD};
          })} style={{...btnPrimary,background:"#b45309",fontSize:12,padding:"6px 14px"}}>
            ↺ Clear Fields (keep carriers &amp; claims)
          </button>
          <button onClick={()=>setShowPreview(true)} style={btnPrimary}>Preview Form →</button>
        </div>

      </>) : (<>
        <div className="no-print" style={{marginBottom:12,display:"flex",gap:8,flexWrap:"wrap"}}>
          <button onClick={()=>setShowPreview(false)} style={{...btnPrimary,background:"#555"}}>← Edit</button>
          <button onClick={()=>window.print()} style={{...btnPrimary,background:"#374151"}}>🖨 Print</button>
          <button onClick={copyTableRich} style={{...btnPrimary,background:copied?"#15803d":"#0f766e"}}>{copied?"✓ Copied!":"📋 Copy Table (with formatting)"}</button>
        </div>

        <table style={{width:"100%",borderCollapse:"collapse",fontFamily:"Calibri, Arial, sans-serif",fontSize:11}}>
          <tbody>
            <tr><td colSpan={2} style={TH_BLUE}>Contact</td><td style={TD_PLAIN}></td><td colSpan={2} style={TH_BLUE}>Applicable to each request</td></tr>
            {[["Name",displayPayeeName,"Payment Type:",PAYMENT_SETTINGS.paymentType],["",addr.careOf||"","Payee Type",PAYMENT_SETTINGS.payeeType],["Address 2",addr.address2||"","Currency",PAYMENT_SETTINGS.currency],["Address 3",addr.address3||"","Payment method",PAYMENT_SETTINGS.paymentMethod],["City",addr.city||"","Item Number",PAYMENT_SETTINGS.itemNumber],["Province",addr.province||"","Other instructions",PAYMENT_SETTINGS.otherInstructions],["Postal Code",addr.postalCode||"","Approver Name & Title",PAYMENT_SETTINGS.approverName]]
              .map(([l,v,rl,rv],i)=>(
                <tr key={i}><td style={TH_BLUE_L}>{l}</td><td style={TD_BLUE}>{v}</td><td style={TD_PLAIN}></td><td style={TH_BLUE_L}>{rl}</td><td style={TD_BLUE}>{rv}</td></tr>
              ))}
            <tr><td colSpan={5} style={TD_PLAIN}></td></tr>
            <tr><td colSpan={5} style={TH_GREEN_C}>Individual Carrier Details</td></tr>
            {previewCarriers.map((label,idx)=>{
              const meta=getCarrierMeta(label),cd=carrierData[label]||emptyCD(label),claimNum=getClaimNum(label);
              const desc=buildDesc(claimNum,strataPlan,dol.label,label,cd.carrierShare,effectiveKind);
              const contract=getContract(label,cd.contractSuffix),invoiceNum=isAdjusterFee?cd.adjustorInvoice:universalInvoice;
              return (
                <React.Fragment key={label}>
                  {idx>0&&<tr><td colSpan={5} style={{...TD_PLAIN,padding:"2px"}}></td></tr>}
                  <tr><td style={TH_GREEN}>Look up Code</td><td style={TD_GREEN} colSpan={4}>{meta?.code}</td></tr>
                  <tr><td style={TH_GREEN}>Cheque Amount</td><td style={TD_GREEN} colSpan={4}>{fmtAmount(cd.chequeAmount)}</td></tr>
                  <tr><td style={TH_GREEN}>Carrier Contract #</td><td style={TD_GREEN} colSpan={4}>{contract}</td></tr>
                  <tr><td style={TH_GREEN}>Attachment / Activity Description</td><td style={TD_GREEN} colSpan={4}>{desc}</td></tr>
                  <tr><td style={TH_GREEN}>Cheque Memo</td><td style={TD_GREEN} colSpan={4}>{desc}</td></tr>
                  <tr><td style={TH_GREEN}>Claim Number</td><td style={TD_GREEN} colSpan={4}>{claimNum}</td></tr>
                  {invoiceNum&&<tr><td style={TH_GREEN}>Adjustor Invoice Number</td><td style={TD_GREEN} colSpan={4}>{invoiceNum}</td></tr>}
                </React.Fragment>
              );
            })}
          </tbody>
        </table>

        <div className="no-print" style={{marginTop:24,padding:"12px 16px",border:"1px solid #6366f1",borderRadius:6,background:"#f5f3ff"}}>
          <div style={{fontWeight:"bold",fontSize:13,color:"#4338ca",marginBottom:8}}>📧 Email Subject Generator</div>
          {isAdjusterFee&&(
            <div style={{marginBottom:8}}>
              <label style={{fontWeight:"bold"}}>Fee Type
                <select style={{...inp,marginTop:3}} value={feeType} onChange={e=>upd("feeType",e.target.value)}>
                  <option value="">— None —</option>
                  <option value="interim fee">interim fee</option>
                  <option value="final fee">final fee</option>
                  <option value="supplemental fee">supplemental fee</option>
                </select>
              </label>
            </div>
          )}
          <div style={{background:"#fff",border:"1px solid #c7d2fe",borderRadius:4,padding:"8px 10px",fontFamily:"monospace",fontSize:13,color:"#1e1b4b",marginBottom:8,wordBreak:"break-all"}}>{emailSubject}</div>
          <button onClick={()=>copyText(emailSubject,setEmailCopied)} style={{...btnPrimary,background:emailCopied?"#15803d":"#4f46e5"}}>{emailCopied?"✓ Copied!":"📋 Copy Subject"}</button>
        </div>
      </>)}
    </div>
  );
}

const inp={display:"block",width:"100%",marginTop:3,padding:"4px 6px",border:"1px solid #ccc",borderRadius:3,fontSize:13,boxSizing:"border-box"};
const fs={marginBottom:16,padding:12,border:"1px solid #ccc",borderRadius:4};
const leg={fontWeight:"bold"};
const grid2={display:"grid",gridTemplateColumns:"1fr 1fr",gap:8};
const btnPrimary={padding:"8px 18px",background:"#2563eb",color:"#fff",border:"none",borderRadius:4,cursor:"pointer",fontSize:13};
const btnDanger={padding:"7px 14px",background:"#fff",color:"#dc2626",border:"2px solid #dc2626",borderRadius:4,cursor:"pointer",fontSize:13,fontWeight:"bold"};
const btnSel={padding:"7px 16px",background:"#1d4ed8",color:"#fff",border:"2px solid #1d4ed8",borderRadius:4,cursor:"pointer",fontSize:13,fontWeight:"bold"};
const btnUnsel={padding:"7px 16px",background:"#fff",color:"#333",border:"2px solid #ccc",borderRadius:4,cursor:"pointer",fontSize:13};

ReactDOM.createRoot(document.getElementById("root")).render(<App/>);
</script>
</body>
</html>
